# ─────────────────────────────────────────────────────────────────────────────
# Frontend environment (Next.js). All NEXT_PUBLIC_* values are shipped to the
# browser — never put secrets here (the Stripe *publishable* key is public).
# ─────────────────────────────────────────────────────────────────────────────

# Backend API origin (separate domain from the frontend).
NEXT_PUBLIC_API_URL=https://api.mzaya.io

# Canonical main SaaS application domain (the APEX — auth + tenant dashboard
# live here, e.g. https://neoleap.ai/dashboard). Tenant subdomains are
# <slug>.<this>. Do NOT use an app.* host as the application domain.
NEXT_PUBLIC_FRONTEND_DOMAIN=neoleap.ai
NEXT_PUBLIC_FRONTEND_PROTOCOL=https

# Cookie domain for shared root-domain auth cookies. Leading dot scopes the
# cookie to the apex + all subdomains (www / admin / <tenant-slug>), which the
# admin→app impersonation handoff needs. Leave UNSET for local dev.
NEXT_PUBLIC_COOKIE_DOMAIN=.neoleap.ai

# Stripe publishable (public) key.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_xxx

# Object storage / CDN host used by next/image (e.g. your S3 or CDN hostname).
NEXT_PUBLIC_STORAGE_HOSTNAME=cdn.example.com
NEXT_PUBLIC_CDN_URL=

# ─────────────────────────────────────────────────────────────────────────────
# REMOVED: NEXT_PUBLIC_TENANT_APP_URL (app.neoleap.ai).
# The SaaS app lives on the apex domain; there is no separate tenant app host.
# ─────────────────────────────────────────────────────────────────────────────
